msgstr "सही तस्वीर अपलोड करें। अपलोड की गई फ़ाइल या तो तस्वीर नहीं थी या खराब थी।"

#: apps/dataio/parsing.py
msgid "Upload an Excel (.xlsx) or CSV file."
msgstr "Excel (.xlsx) या CSV फ़ाइल अपलोड करें।"

#: apps/billing/numbering.py
msgid "Use 1 to 3 capital letters or digits."
msgstr "1 से 3 बड़े अक्षर या अंक डालें।"

#: apps/platform/validators.py
msgid "Use 3 to 30 lowercase letters, numbers or hyphens, starting and ending with a letter or number."
msgstr "3 से 30 छोटे अक्षर, अंक या हाइफ़न डालें, जो अक्षर या अंक से शुरू और खत्म हों।"

#: apps/dataio/kinds/ledger.py
msgid "Use a date like 15-02-2026."
msgstr "15-02-2026 जैसी तारीख डालें।"

#: apps/ledger/api/views.py
#, python-format
msgid "Use a number from 1 to %(maximum)s."
msgstr "1 से %(maximum)s तक की संख्या डालें।"

#: apps/notifications/texts.py
#, python-format
msgid "Use at most %(limit)s characters."
msgstr "अधिकतम %(limit)s अक्षर डालें।"

#: apps/notifications/announcements.py
#, python-format
msgid "Use at most %(max_body)s characters."
msgstr "अधिकतम %(max_body)s अक्षर डालें।"

#: apps/notifications/texts.py
#, python-format
msgid "Use at most %(max_subject)s characters."
msgstr "अधिकतम %(max_subject)s अक्षर डालें।"

#: apps/notifications/announcements.py
#, python-format
msgid "Use at most %(max_title)s characters."
msgstr "अधिकतम %(max_title)s अक्षर डालें।"

#: apps/platform/registry.py
msgid "Use at most 2 decimal places."
msgstr "अधिकतम 2 दशमलव स्थान डालें।"

#: apps/dataio/kinds/products.py
msgid "Use at most 40 characters."
msgstr "अधिकतम 40 अक्षर डालें।"

#: apps/platform/master_services.py
msgid "Use feature codes from the flag catalogue."
msgstr "फ़्लैग सूची के फ़ीचर कोड डालें।"

#: apps/ledger/api/views.py
msgid "Use INVOICE_DATE or DUE_DATE."
msgstr "INVOICE_DATE या DUE_DATE डालें।"

#: apps/orders/api/views.py
#, python-format
msgid "Use one of: %(tabs)s."
msgstr "इनमें से एक डालें: %(tabs)s।"

#: apps/shop/api/orders.py
msgid "Use open or closed."
msgstr "open या closed डालें।"

#: apps/shop/api/billing.py
msgid "Use unpaid, paid or overdue."
msgstr "unpaid, paid या overdue डालें।"

#: apps/billing/api/views.py apps/inventory/api/views.py apps/ledger/api/views.py
msgid "Use YYYY-MM-DD."
msgstr "YYYY-MM-DD डालें।"

#: apps/billing/labels.py
msgid "Valid until"
msgstr "तक मान्य"

#: apps/billing/labels.py
msgid "Vehicle"
msgstr "गाड़ी"

#: apps/billing/labels.py
msgid "Voucher no."
msgstr "वाउचर नं."

#: apps/accounts/permissions.py
msgid "Warehouse"
msgstr "गोदाम"

#: apps/dataio/services.py
msgid "We couldn't check this file. Please upload it again."
msgstr "हम इस फ़ाइल की जाँच नहीं कर सके। कृपया इसे फिर से अपलोड करें।"

#: apps/dataio/parsing.py
msgid "We couldn't find the column names. Use the template, or put the column names in the first row."
msgstr "हमें कॉलम के नाम नहीं मिले। टेम्पलेट का उपयोग करें, या पहली पंक्ति में कॉलम के नाम लिखें।"

#: common/errors.py
msgid "We couldn't find what you were looking for."
msgstr "आप जो ढूँढ रहे थे, वह हमें नहीं मिला।"

#: apps/dataio/kinds/products.py
msgid "What one unit costs you. Never shown to shops. Needs the cost permission."
msgstr "एक यूनिट आपको कितने में पड़ती है। दुकानों को कभी नहीं दिखता। लागत की अनुमति ज़रूरी है।"

#: apps/dataio/kinds/ledger.py
msgid "What the shop owes you. Use a minus sign for money the shop paid in advance."
msgstr "दुकान पर आपका कितना बकाया है। दुकान ने पहले से जो भुगतान किया है, उसके लिए माइनस चिह्न लगाएँ।"

#: apps/dataio/services.py
msgid "What to enter"
msgstr "क्या डालें"

#: apps/dataio/services.py
msgid "What to fix"
msgstr "क्या ठीक करें"

#: apps/notifications/texts.py
msgid "WhatsApp and SMS texts are set by the platform (approved templates)."
msgstr "WhatsApp और SMS टेक्स्ट प्लेटफ़ॉर्म तय करता है (मंज़ूर टेम्पलेट)।"

#: apps/dataio/kinds/ledger.py
msgid "When the bill was due (DD-MM-YYYY). The shop's payment terms after the bill date if empty."
msgstr "बिल की देय तारीख (DD-MM-YYYY)। खाली हो तो बिल की तारीख के बाद दुकान की भुगतान शर्तें।"

#: apps/billing/labels.py
msgid "Within the state (CGST + SGST)"
msgstr "राज्य के अंदर (CGST + SGST)"

#: apps/dataio/kinds/products.py
msgid "Words that help search, separated by commas."
msgstr "खोज में मदद करने वाले शब्द, कॉमा से अलग।"

#: apps/dataio/kinds/pricing.py
msgid "Write % (percentage) or ₹ (rupees off each unit)."
msgstr "% (प्रतिशत) या ₹ (हर यूनिट पर रुपये की छूट) लिखें।"

#: apps/dataio/kinds/retailers.py
#, python-format
msgid "Write %(languages)s."
msgstr "%(languages)s लिखें।"

#: apps/inventory/adjustments.py
msgid "Write a short note about why the stock changes."
msgstr "स्टॉक क्यों बदल रहा है, इस पर छोटी टिप्पणी लिखें।"

#: apps/platform/text_suggestions.py
msgid "Write the better word."
msgstr "बेहतर शब्द लिखें।"

#: apps/notifications/sms_preview.py
msgid "Write the short name on one line, up to 30 letters."
msgstr "छोटा नाम एक ही पंक्ति में, 30 अक्षरों तक लिखें।"

#: apps/platform/tenant_settings_services.py
msgid "Write the short name on one line."
msgstr "छोटा नाम एक ही पंक्ति में लिखें।"

#: apps/dataio/kinds/pricing.py
#, python-format
msgid "Write Yes or No (not “%(is_active)s”)."
msgstr "Yes या No लिखें (“%(is_active)s” नहीं)।"

#: apps/dataio/kinds/products.py
#, python-format
msgid "Write Yes or No (not “%(value)s”)."
msgstr "Yes या No लिखें (“%(value)s” नहीं)।"

#: apps/dataio/kinds/retailers.py
msgid "Write Yes or No."
msgstr "Yes या No लिखें।"

#: apps/billing/models.py
msgid "Wrong item"
msgstr "गलत आइटम"

#: apps/billing/labels.py apps/dataio/services.py
msgid "Yes"
msgstr "हाँ"

#: apps/dataio/kinds/retailers.py
msgid "Yes only if the shop agreed to get WhatsApp messages. No stops them."
msgstr "Yes केवल तभी जब दुकान WhatsApp संदेश पाने के लिए सहमत हो। No से वे बंद हो जाते हैं।"

#: apps/dataio/kinds/pricing.py apps/dataio/kinds/products.py
msgid "Yes or No (default Yes)."
msgstr "Yes या No (डिफ़ॉल्ट Yes)।"

#: apps/platform/api/tenant_views.py
#, python-format
msgid "You can't change: %(denied)s."
msgstr "आप ये नहीं बदल सकते: %(denied)s।"

#: apps/accounts/staff_services.py
msgid "You can't deactivate yourself."
msgstr "आप खुद को निष्क्रिय नहीं कर सकते।"

#: apps/dataio/kinds/products.py
msgid "You can't set cost prices. Remove this column or ask someone who manages costs."
msgstr "आप लागत मूल्य तय नहीं कर सकते। यह कॉलम हटाएँ या लागत संभालने वाले किसी व्यक्ति से कहें।"

#: apps/dataio/kinds/retailers.py
msgid "You can't set credit limits or payment days. Remove these columns or ask someone with the credit permission."
msgstr "आप क्रेडिट सीमा या भुगतान के दिन तय नहीं कर सकते। ये कॉलम हटाएँ या क्रेडिट की अनुमति वाले किसी व्यक्ति से कहें।"

#: common/framework_messages.py
msgid "You do not have permission to perform this action."
msgstr "आपको यह करने की अनुमति नहीं है।"

#: apps/notifications/preferences.py
msgid "You don't get this message on this channel."
msgstr "आपको यह संदेश इस माध्यम पर नहीं मिलता।"

#: apps/accounts/tasks.py
#, python-format
msgid "You have been invited to join %(business)s as %(role)s."
msgstr "आपको %(business)s में %(role)s के रूप में जुड़ने के लिए आमंत्रित किया गया है।"

#: apps/payments/online.py
msgid "You have nothing to pay right now."
msgstr "अभी आपको कुछ भुगतान नहीं करना है।"

#: apps/accounts/authentication.py
msgid "You no longer have access."
msgstr "अब आपकी पहुँच नहीं है।"

#: apps/accounts/tasks.py
#, python-format
msgid "You're invited to join %(business)s"
msgstr "आपको %(business)s में जुड़ने का आमंत्रण"

#: apps/ai/assistant/service.py
msgid "You've asked a lot of questions in the last hour. Try again a little later."
msgstr "आपने पिछले एक घंटे में बहुत सवाल पूछे हैं। थोड़ी देर बाद फिर कोशिश करें।"

#: apps/accounts/services.py apps/orders/services.py
msgid "Your account is on hold. Please contact your distributor."
msgstr "आपका खाता होल्ड पर है। कृपया अपने वितरक से संपर्क करें।"

#: apps/orders/services.py
msgid "Your cart needs a change before you can place the order."
msgstr "ऑर्डर करने से पहले आपके कार्ट में एक बदलाव ज़रूरी है।"

#: apps/dataio/kinds/products.py
msgid "Your code for the product. Unique; used to find it again."
msgstr "उत्पाद के लिए आपका कोड। अनोखा; इसी से उत्पाद फिर से मिलता है।"

#: apps/dataio/kinds/stock.py
msgid "Your cost setting is “Never”, so the cost price won't change."
msgstr "आपकी लागत सेटिंग “कभी नहीं” है, इसलिए लागत मूल्य नहीं बदलेगा।"

#: apps/orders/fulfilment.py
msgid "Your distributor marks deliveries."
msgstr "डिलीवरी आपका वितरक दर्ज करता है।"

#: apps/billing/returns.py
msgid "Your distributor takes returns by phone."
msgstr "आपका वितरक वापसी फ़ोन पर लेता है।"

#: apps/accounts/staff_services.py
msgid "Your plan's limit has been reached."
msgstr "आपके प्लान की सीमा पूरी हो गई है।"

#: apps/dataio/kinds/products.py
msgid "Your selling price per unit."
msgstr "हर यूनिट की आपकी बिक्री कीमत।"

#: apps/accounts/tokens.py
msgid "Your session has ended. Please sign in again."
msgstr "आपका सत्र खत्म हो गया है। कृपया फिर से साइन इन करें।"
