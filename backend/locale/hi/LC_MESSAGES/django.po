#: apps/accounts/tasks.py
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"Someone asked to reset the password for your account. To choose a new password, open this link:\n"
"\n"
"%(link)s\n"
"\n"
"The link works once. If you didn't ask for this, you can ignore this email.\n"
msgstr ""
"नमस्ते %(name)s,\n"
"\n"
"किसी ने आपके खाते का पासवर्ड बदलने को कहा है। नया पासवर्ड चुनने के लिए यह लिंक खोलें:\n"
"\n"
"%(link)s\n"
"\n"
"यह लिंक एक ही बार काम करता है। अगर आपने यह नहीं माँगा, तो इस ईमेल को अनदेखा करें।\n"

#: apps/accounts/tasks.py
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"We paused sign-in to your account for a few minutes because the password was entered incorrectly several times.\n"
"\n"
"If this was you, wait a few minutes and try again, or reset your password.\n"
"If it wasn't you, reset your password now: someone may be trying to get in.\n"
msgstr ""
"नमस्ते %(name)s,\n"
"\n"
"पासवर्ड कई बार गलत डाला गया, इसलिए हमने आपके खाते में साइन इन कुछ मिनटों के लिए रोक दिया है।\n"
"\n"
"अगर यह आप थे, तो कुछ मिनट रुककर फिर कोशिश करें, या अपना पासवर्ड बदलें।\n"
"अगर यह आप नहीं थे, तो अभी अपना पासवर्ड बदलें: कोई अंदर आने की कोशिश कर रहा हो सकता है।\n"

#: apps/accounts/tasks.py
#, python-format
msgid ""
"Hello,\n"
"\n"
"%(invited)s\n"
"\n"
"To accept, open this link:\n"
"\n"
"%(link)s\n"
"\n"
"The link works for 7 days. If you weren't expecting this, you can ignore it.\n"
msgstr ""
"नमस्ते,\n"
"\n"
"%(invited)s\n"
"\n"
"स्वीकार करने के लिए यह लिंक खोलें:\n"
"\n"
"%(link)s\n"
"\n"
"यह लिंक 7 दिन तक काम करता है। अगर आपको इसकी उम्मीद नहीं थी, तो इसे अनदेखा करें।\n"

