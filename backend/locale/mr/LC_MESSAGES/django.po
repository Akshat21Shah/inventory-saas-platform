#: apps/accounts/tasks.py:87
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"Someone asked to reset the password for your account. To choose a new password, open this link:\n"
"\n"
"%(link)s\n"
"\n"
"The link works once. If you didn't ask for this, you can ignore this email.\n"
msgstr ""
"नमस्कार %(name)s,\n"
"\n"
"कोणीतरी तुमच्या खात्याचा पासवर्ड बदलण्याची विनंती केली आहे. नवीन पासवर्ड निवडण्यासाठी ही लिंक उघडा:\n"
"\n"
"%(link)s\n"
"\n"
"ही लिंक एकदाच चालते. तुम्ही ही विनंती केली नसेल, तर या ईमेलकडे दुर्लक्ष करा.\n"

#: apps/accounts/tasks.py:50
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"We paused sign-in to your account for a few minutes because the password was entered incorrectly several times.\n"
"\n"
"If this was you, wait a few minutes and try again, or reset your password.\n"
"If it wasn't you, reset your password now: someone may be trying to get in.\n"
msgstr ""
"नमस्कार %(name)s,\n"
"\n"
"पासवर्ड अनेकदा चुकीचा भरला गेला, म्हणून आम्ही तुमच्या खात्यात साइन इन काही मिनिटांसाठी थांबवले आहे.\n"
"\n"
"हे तुम्ही असाल, तर काही मिनिटे थांबून पुन्हा प्रयत्न करा, किंवा तुमचा पासवर्ड बदला.\n"
"हे तुम्ही नसाल, तर आत्ताच तुमचा पासवर्ड बदला: कोणीतरी आत येण्याचा प्रयत्न करत असू शकते.\n"

#: apps/accounts/tasks.py:149
#, python-format
msgid ""
"Hello,\n"
"\n"
"%(invited)s\n"
"\n"
"To accept, open this link:\n"
"\n"
"%(link)s\n"
"\n"
"The link works for 7 days. If you weren't expecting this, you can ignore it.\n"
msgstr ""
"नमस्कार,\n"
"\n"
"%(invited)s\n"
"\n"
"स्वीकारण्यासाठी ही लिंक उघडा:\n"
"\n"
