# Copy to .env (make does this automatically). Values here are for LOCAL DEVELOPMENT ONLY.
# Host-run commands (pytest, manage.py) use these; containers override hosts in infra/docker-compose.yml.
ENVIRONMENT=local
# >= 32 bytes (also the HS256 JWT signing key unless JWT_SIGNING_KEY is set)
DJANGO_SECRET_KEY=dev-insecure-local-only-secret-key-change-me
DJANGO_DEBUG=true
PLATFORM_DOMAIN=localhost
LOG_FORMAT=console

# Runtime role (RLS enforced) / migration owner / audited platform role
DATABASE_URL=postgres://app_user:app_user@localhost:5432/inventory
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner@localhost:5432/inventory
PLATFORM_DATABASE_URL=postgres://app_platform:app_platform@localhost:5432/inventory

REDIS_URL=redis://localhost:6379/0
EMAIL_HOST=localhost
EMAIL_PORT=1025

# S3-compatible storage (SeaweedFS in dev, ADR-024) — used by the storage adapter from Phase 1
S3_ENDPOINT_URL=http://localhost:8333
# Where browsers fetch files from (presigned links). Compose points S3_ENDPOINT_URL at the
# in-network host for the containers; this one stays the host-reachable address.
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=inventory-dev
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key-change-me

# Field-level encryption (ADR-031): comma-separated Fernet keys, the first one encrypts. Leave commented
# out in dev to use the built-in dev key; production refuses to start without real keys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEYS=
# Plan limits are defined but not enforced until this is on (spec 5.1)
PLAN_ENFORCEMENT_ENABLED=false

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
